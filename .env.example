ANTHROPIC_API_KEY=sua_chave_aqui
PORT=3001

# Fase 2 - voz (ElevenLabs). Deixe em branco se ainda não for usar TTS.
# IMPORTANTE: no plano free, o voice ID precisa ser de uma voz CLONADA por você
# (Instant Voice Cloning), não uma voz adicionada da biblioteca — a API bloqueia
# vozes de biblioteca no free tier mesmo que apareçam em "My Voices" no painel.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Reservada pro pipeline de RAG das reuniões (busca vetorial), ainda não usada no código.
VOYAGE_API_KEY=

# Senha compartilhada do time (legado, opcional). Em branco = sem senha (uso local).
# Em produção, defina COLABORADORES (abaixo) — sem nenhuma das duas, qualquer um
# com o link usa o app e gasta crédito da sua conta Anthropic/ElevenLabs.
TEAM_PASSWORD=

# Senha individual por colaborador, formato senha:Nome,senha2:Nome2.
# A identidade usada nos logs e relatórios vem da senha usada pra entrar.
COLABORADORES=

# Relatório de simulação por email (Resend — resend.com). Sem isso, o relatório
# simplesmente não é enviado (não quebra o app).
RESEND_API_KEY=
REPORT_EMAIL_TO=
