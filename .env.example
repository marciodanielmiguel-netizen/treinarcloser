ANTHROPIC_API_KEY=sua_chave_aqui
PORT=3001

# Fase 2 - voz (ElevenLabs). Deixe em branco se ainda não for usar TTS.
# IMPORTANTE: no plano free, o voice ID precisa ser de uma voz CLONADA por você
# (Instant Voice Cloning), não uma voz adicionada da biblioteca — a API bloqueia
# vozes de biblioteca no free tier mesmo que apareçam em "My Voices" no painel.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Reservada pro pipeline de RAG das reuniões (busca vetorial), ainda não usada no código.
VOYAGE_API_KEY=

# Senha compartilhada do time. Em branco = sem senha (uso local).
# Em produção, defina um valor — sem isso, qualquer um com o link usa o app e
# gasta crédito da sua conta Anthropic/ElevenLabs.
TEAM_PASSWORD=
